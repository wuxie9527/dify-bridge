# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///data/battery.db

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs

# 应用配置
APP_NAME=Dify Bridge
APP_VERSION=2.0.0

# 阿里云 OCR 配置（新版 SDK）
# 从阿里云控制台获取：https://ram.console.aliyun.com/manage/ak
ALIBABA_CLOUD_ACCESS_KEY_ID=你的 AccessKey ID
ALIBABA_CLOUD_ACCESS_KEY_SECRET=你的 AccessKey Secret
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# Tair 云数据库（向量缓存）
# 从阿里云 Tair 实例的连接信息中获取，建议使用公网/内网地址按部署环境选择
TAIR_HOST=r-xxxxxxxx-public.redis.cn-beijing.rds.aliyuncs.com
TAIR_PORT=6379
TAIR_PASSWORD=你的实例密码
TAIR_VECTOR_INDEX=diagnosis_cache

# 阿里云百炼 DashScope（用户提问向量化）
# 开通地址：https://bailian.console.aliyun.com/ ，API-KEY 管理页获取
DASHSCOPE_API_KEY=sk-xxxxxxxx
EMBEDDING_MODEL=text-embedding-v3
# 可选维度：64/128/256/512/768/1024，与 TAIR 索引维度保持一致，修改需重建索引
EMBEDDING_DIMENSION=1024
